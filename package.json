{
  "name": "Desktop48",
  "type": "module",
  "version": "0.1.9",
  "description": "Desktop48",
  "author": "Zack",
  "license": "MIT",
  "homepage": "https://github.com/mirtu-ko/desktop48.app",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -w",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node node_modules/electron/install.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.7",
    "hls.js": "^1.7.3",
    "mitt": "^3.0.1",
    "mpegts.js": "^1.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.5.0",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
