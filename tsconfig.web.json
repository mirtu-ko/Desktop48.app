{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@preload/*": [
        "./src/preload/*"
      ]
    }
  },
  "include": [
    "src/common/**/*",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts"
  ]
}
